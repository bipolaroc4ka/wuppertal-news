{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wuppertal-news",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true
  },
  // Два cron-триггера из пяти доступных на Workers Free:
  //   каждую минуту  - тик конвейера (одна небольшая задача за вызов)
  //   03:00 UTC      - ежедневное обслуживание
  "triggers": {
    "crons": ["* * * * *", "0 3 * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "wuppertal-news",
      // Подставьте database_id из вывода команды: npx wrangler d1 create wuppertal-news
      "database_id": "REPLACE_WITH_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ]
}
